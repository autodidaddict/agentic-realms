<Layouts.app
  flash={@flash}
  current_player={@current_player}
  game_mode={@mode}
  is_wizard={@is_wizard}
>
  <div class="app" id="game-root" phx-hook=".ThemeSwitch">
    <%= if @mode == :player do %>
      <.player_view
        log={@log}
        stats={@stats}
        inventory={@inventory}
        quests={@quests}
        presence={@presence}
        input={@input}
        streaming={@streaming}
        map_open={@map_open}
        map_view={@map_view}
        input_locked={@input_locked}
        tweaks={@tweaks}
      />

      <.stats_modal :if={@modal == :stats} stats={@stats} />
      <.inventory_modal :if={@modal == :inv} inventory={@inventory} />
      <.quest_modal
        :if={@modal == :quests}
        quests={@quests}
        completed_quests={@completed_quests}
      />
      <.presence_modal :if={@modal == :presence} presence={@presence} />
    <% else %>
      <.wizard_authoring_view
        authoring_mode={@authoring_mode}
        focused_blueprint_draft={@focused_blueprint_draft}
        focused_object_draft={@focused_object_draft}
        focused_object_edit={@focused_object_edit}
        object_blueprints={@object_blueprints}
        room_objects={@room_objects}
        wizard_prompt={@wizard_prompt}
        wizard_input_locked={@wizard_input_locked}
        blueprint_commit_error={@blueprint_commit_error}
        current_room_id={@current_room_id}
        current_room_name={@current_room_name}
        last_spawn={@last_spawn}
        tweaks={@tweaks}
      />
    <% end %>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".ThemeSwitch">
    export default {
      mounted() {
        this.handleEvent("set_theme", ({theme}) => {
          document.documentElement.setAttribute("data-theme", theme);
          localStorage.setItem("ar:theme", theme);
        });
        this.handleEvent("set_density", ({density}) => {
          document.documentElement.setAttribute("data-density", density);
          localStorage.setItem("ar:density", density);
        });
      }
    }
  </script>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".StreamingText">
    export default {
      mounted() {
        this.handleEvent("stream_text", ({text}) => {
          let i = 0;
          const el = this.el;
          el.innerHTML = '<span class="cursor"></span>';
          const id = setInterval(() => {
            i += 5;
            const visible = text.slice(0, i);
            el.innerHTML = visible + '<span class="cursor"></span>';
            if (i >= text.length) {
              clearInterval(id);
              el.innerHTML = text;
              this.pushEvent("stream_done", {});
            }
          }, 14);
        });
      }
    }
  </script>
</Layouts.app>
