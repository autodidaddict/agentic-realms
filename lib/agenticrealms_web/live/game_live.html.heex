<Layouts.app flash={@flash} current_player={@current_player} game_mode={@mode}>
  <div class="app" id="game-root" phx-hook=".ThemeSwitch">
    <%= if @mode == :player do %>
      <.player_view
        log={@log}
        stats={@stats}
        inventory={@inventory}
        quests={@quests}
        presence={@presence}
        suggestions={@suggestions}
        input={@input}
        streaming={@streaming}
        map_open={@map_open}
        map_view={@map_view}
        input_locked={@input_locked}
        tweaks={@tweaks}
      />

      <.stats_modal :if={@modal == :stats} stats={@stats} />
      <.inventory_modal :if={@modal == :inv} inventory={@inventory} />
      <.quest_modal
        :if={@modal == :quests}
        quest_details={@quest_details}
        selected_quest={@selected_quest}
      />
      <.presence_modal :if={@modal == :presence} presence={@presence} />
    <% else %>
      <.wizard_view
        kind={@wizard_kind}
        text={@wizard_text}
        tweaks={@tweaks}
        wizard_examples={@wizard_examples}
      />

      <.trigger_modal :if={@open_trigger} trigger={@open_trigger} />
    <% end %>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".ThemeSwitch">
    export default {
      mounted() {
        this.handleEvent("set_theme", ({theme}) => {
          document.documentElement.setAttribute("data-theme", theme);
          localStorage.setItem("ar:theme", theme);
        });
        this.handleEvent("set_density", ({density}) => {
          document.documentElement.setAttribute("data-density", density);
          localStorage.setItem("ar:density", density);
        });
      }
    }
  </script>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".ScrollBottom">
    // Always pin the log to its newest entry on any DOM mutation.
    // Driven by a MutationObserver because Phoenix LiveView's updated()
    // hook callback doesn't reliably fire for every code path that
    // appends to :log (background timer emissions and PubSub-driven
    // utterances arrive on patches where the parent element's own
    // attributes don't change).
    //
    // No sticky-bottom heuristic: a previous version of this hook only
    // pinned when the user was already at the bottom, but LiveView's
    // morph cycle can briefly shift scrollTop while the DOM grows,
    // which races with the scroll-position check and stops the pin
    // from firing. Always-pin is the user-visible contract: every new
    // log entry shows up.
    export default {
      _pin() {
        requestAnimationFrame(() => {
          this.el.scrollTop = this.el.scrollHeight;
        });
      },
      mounted() {
        this._observer = new MutationObserver(() => this._pin());
        this._observer.observe(this.el, { childList: true, subtree: true });

        this._pin();

        // Explicit server-side trigger (used by toggle_map after the
        // panel covers/uncovers the bottom of the log).
        this.handleEvent("scroll_log_to_bottom", () => this._pin());
      },
      destroyed() {
        if (this._observer) this._observer.disconnect();
      }
    }
  </script>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".StreamingText">
    export default {
      mounted() {
        this.handleEvent("stream_text", ({text}) => {
          let i = 0;
          const el = this.el;
          el.innerHTML = '<span class="cursor"></span>';
          const id = setInterval(() => {
            i += 5;
            const visible = text.slice(0, i);
            el.innerHTML = visible + '<span class="cursor"></span>';
            if (i >= text.length) {
              clearInterval(id);
              el.innerHTML = text;
              this.pushEvent("stream_done", {});
            }
          }, 14);
        });
      }
    }
  </script>

</Layouts.app>
