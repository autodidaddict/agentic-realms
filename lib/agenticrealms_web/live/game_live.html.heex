<Layouts.app flash={@flash} current_player={@current_player} game_mode={@mode}>
  <div class="app" id="game-root" phx-hook=".ThemeSwitch">
    <%= if @mode == :player do %>
      <.player_view
        log={@log}
        stats={@stats}
        inventory={@inventory}
        quests={@quests}
        presence={@presence}
        suggestions={@suggestions}
        input={@input}
        streaming={@streaming}
        map_open={@map_open}
        map_view={@map_view}
        input_locked={@input_locked}
        tweaks={@tweaks}
      />

      <.stats_modal :if={@modal == :stats} stats={@stats} />
      <.inventory_modal :if={@modal == :inv} inventory={@inventory} />
      <.quest_modal
        :if={@modal == :quests}
        quest_details={@quest_details}
        selected_quest={@selected_quest}
      />
      <.presence_modal :if={@modal == :presence} presence={@presence} />
    <% else %>
      <.wizard_view
        kind={@wizard_kind}
        text={@wizard_text}
        tweaks={@tweaks}
        wizard_examples={@wizard_examples}
      />

      <.trigger_modal :if={@open_trigger} trigger={@open_trigger} />
    <% end %>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".ThemeSwitch">
    export default {
      mounted() {
        this.handleEvent("set_theme", ({theme}) => {
          document.documentElement.setAttribute("data-theme", theme);
          localStorage.setItem("ar:theme", theme);
        });
        this.handleEvent("set_density", ({density}) => {
          document.documentElement.setAttribute("data-density", density);
          localStorage.setItem("ar:density", density);
        });
      }
    }
  </script>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".ScrollBottom">
    // Keep the log pinned to its newest entry. Driven by a
    // MutationObserver on the log subtree because Phoenix LiveView's
    // updated() hook doesn't reliably fire for every code path that
    // appends to :log (esp. background timer / PubSub emissions where
    // the DOM mutation arrives on a different patch than the parent
    // element's own attributes).
    //
    // The observer also implements "smart pin": if the user has scrolled
    // up to read older content, we leave them where they are. We only
    // pin when they were already at (or within 48 px of) the bottom.
    export default {
      _NEAR_BOTTOM_PX: 48,
      _isAtBottom() {
        const slack = this.el.scrollHeight - this.el.clientHeight - this.el.scrollTop;
        return slack <= this._NEAR_BOTTOM_PX;
      },
      _pin() {
        // Defer one frame so the newly-inserted content's layout is
        // applied before we read scrollHeight.
        requestAnimationFrame(() => {
          this.el.scrollTop = this.el.scrollHeight;
        });
      },
      mounted() {
        this._wasAtBottom = true;
        this._onScroll = () => { this._wasAtBottom = this._isAtBottom(); };
        this.el.addEventListener("scroll", this._onScroll, { passive: true });

        this._observer = new MutationObserver(() => {
          if (this._wasAtBottom) this._pin();
        });
        this._observer.observe(this.el, { childList: true, subtree: true });

        this._pin();

        // Explicit re-pin (e.g., when toggling the map panel — the
        // backdrop-blurred panel covers the bottom of the log; the
        // server pushes this event after the toggle so we snap to the
        // newest line above the panel).
        this.handleEvent("scroll_log_to_bottom", () => {
          this._wasAtBottom = true;
          this._pin();
        });
      },
      destroyed() {
        if (this._observer) this._observer.disconnect();
        if (this._onScroll) this.el.removeEventListener("scroll", this._onScroll);
      }
    }
  </script>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".StreamingText">
    export default {
      mounted() {
        this.handleEvent("stream_text", ({text}) => {
          let i = 0;
          const el = this.el;
          el.innerHTML = '<span class="cursor"></span>';
          const id = setInterval(() => {
            i += 5;
            const visible = text.slice(0, i);
            el.innerHTML = visible + '<span class="cursor"></span>';
            if (i >= text.length) {
              clearInterval(id);
              el.innerHTML = text;
              this.pushEvent("stream_done", {});
            }
          }, 14);
        });
      }
    }
  </script>

</Layouts.app>
