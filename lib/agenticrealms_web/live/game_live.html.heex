<Layouts.game flash={@flash}>
  <div class="app" id="game-root" phx-hook=".ThemeSwitch">
    <.topbar mode={@mode} stats={@stats} />

    <%= if @mode == :player do %>
      <.player_view
        log={@log}
        stats={@stats}
        inventory={@inventory}
        quests={@quests}
        presence={@presence}
        suggestions={@suggestions}
        input={@input}
        streaming={@streaming}
        map_open={@map_open}
        tweaks={@tweaks}
      />

      <.stats_modal :if={@modal == :stats} stats={@stats} />
      <.inventory_modal :if={@modal == :inv} inventory={@inventory} />
      <.quest_modal
        :if={@modal == :quests}
        quest_details={@quest_details}
        selected_quest={@selected_quest}
      />
      <.presence_modal :if={@modal == :presence} presence={@presence} />
    <% else %>
      <.wizard_view
        kind={@wizard_kind}
        text={@wizard_text}
        tweaks={@tweaks}
        wizard_examples={@wizard_examples}
      />

      <.trigger_modal :if={@open_trigger} trigger={@open_trigger} />
    <% end %>

    <.tweaks_panel :if={@tweaks_open} tweaks={@tweaks} />

    <button
      style="position: fixed; bottom: 16px; right: 16px; z-index: 40; display: inline-flex; align-items: center; justify-content: center; background: var(--bg-elev); border: 1px solid var(--line); color: var(--ink-dim); width: 34px; height: 34px; border-radius: var(--radius); cursor: pointer;"
      phx-click="toggle_tweaks"
      title="Toggle tweaks"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
        <circle cx="12" cy="12" r="3" />
      </svg>
    </button>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".ThemeSwitch">
    export default {
      mounted() {
        this.handleEvent("set_theme", ({theme}) => {
          document.documentElement.setAttribute("data-theme", theme);
          localStorage.setItem("ar:theme", theme);
        });
        this.handleEvent("set_density", ({density}) => {
          document.documentElement.setAttribute("data-density", density);
          localStorage.setItem("ar:density", density);
        });
      }
    }
  </script>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".ScrollBottom">
    export default {
      mounted() { this.el.scrollTop = this.el.scrollHeight; },
      updated() { this.el.scrollTop = this.el.scrollHeight; }
    }
  </script>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".StreamingText">
    export default {
      mounted() {
        this.handleEvent("stream_text", ({text}) => {
          let i = 0;
          const el = this.el;
          el.innerHTML = '<span class="cursor"></span>';
          const id = setInterval(() => {
            i += 5;
            const visible = text.slice(0, i);
            el.innerHTML = visible + '<span class="cursor"></span>';
            if (i >= text.length) {
              clearInterval(id);
              el.innerHTML = text;
              this.pushEvent("stream_done", {});
            }
          }, 14);
        });
      }
    }
  </script>
</Layouts.game>
